{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["REACT_PRODUCTION_PROFILING", "SANITY_STUDIO_OAUTH_CLIENT_ID"],
      "outputs": [".sanity/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
