{
  "about": "One diagram spec, drawn in the Design options window (dev/variants-2-0-studio/design-options/diagram.tsx) and in the design tracker artifact. Edit here; the studio copy is options/diagrams.json (recopy).",
  "space": "New diagrams are drawn on a 320 x 170 grid (flows 320 x 64, the lens-homes figure 320 x 152). Entries with `generic` keep the older 200 x 100 app frame plus highlighted shapes (kind box|pill|dot, optional frame: inspector, dashed).",
  "primitives": {
    "nav": "{active=3} top bar: logo, five tool tabs (tab `active` highlighted), two round buttons.",
    "lens": "{active, picker=true} View-by switch: label, four segments, optional pin picker at the right.",
    "card": "{x,y,w,h} outlined panel.",
    "title": "{y, w=70} heading bar with a subtitle bar.",
    "tabs": "{y, n=3, search=true, btn} filter tabs (first active), search field, then either a primary button (btn 'b') or two round icons.",
    "head": "{y, cols:[[x,w]], x0=14} table header band with column labels.",
    "row": "{y, cells:[[x,w,kind]], grey, checked, h=14} table row: checkbox, doc icon, title and subline, then cells. kind: n neutral chip, v violet chip, r blue chip, g grey chip, t text bar, dot violet dot + text. grey = the document has no version (muted); checked = selected (blue box, violet wash).",
    "selectionBar": "{} the bulk bar under the title: count, hints, primary action.",
    "dialog": "{} scrim plus a confirm dialog: title, four key/value lines, Cancel and a red confirm.",
    "pane": "{x,y,w,h,stroke,rx,dash} outline only.",
    "box": "{x,y,w,h,fill,op,stroke,rx,dash} filled rectangle. fill: bar, violet, blue, red, brand, faint, none, bg, black, check, border.",
    "bar": "{x,y,w,h=3,op} a line of text, drawn as a bar.",
    "chip": "{x,y,w,kind} 5 high chip: n, v, r, g.",
    "label": "{x,y,text} real text, 7 high.",
    "flowBox": "{label, kind} one step in a flow strip; boxes share the width evenly, joined by arrows. kind: n, v, r."
  },
  "statusClasses": "status.class: win (built or shipped), even (candidate, alternative, partly proposed), open (exploration or not drawn).",
