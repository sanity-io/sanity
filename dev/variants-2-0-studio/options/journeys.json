[
  {
    "id": "j01",
    "task": "T2",
    "title": "An editor creates a first variant definition by hand",
    "stage": "Open beta",
    "persona": "editor",
    "components": [
      "C2",
      "C6"
    ],
    "steps": [
      {
        "title": "Open the Variants tool",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The shipped overview lists definitions with document counts. An empty state offers to create the first one.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--no-definitions"
      },
      {
        "title": "Start a new definition",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "A dialog asks for the dimension and the definition title.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--create-dialog"
      },
      {
        "title": "Add the first condition",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The same dialog takes one condition (for example locale = de-DE) and saves.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--create-dialog"
      },
      {
        "title": "See the definition in the list",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The detail page of the new definition shows 0 documents and a Create action.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--definition-no-documents"
      }
    ]
  },
  {
    "id": "j02",
    "task": "T2",
    "title": "An editor changes a variant definition",
    "stage": "Open beta",
    "persona": "editor",
    "components": [
      "C6"
    ],
    "steps": [
      {
        "title": "Open a definition",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The detail page shows the definition, its conditions and its documents.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--definition-with-documents"
      },
      {
        "title": "Change a condition",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The Edit dialog opens with the conditions of the definition.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--edit-dialog"
      },
      {
        "title": "Read the consequence",
        "component": "C6",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/variants",
        "expect": "The dialog names how many documents the change affects before saving.",
        "story": "explorations-variants-2-0-components-c6-variants-tool--edit-dialog"
      }
    ]
  },
  {
    "id": "j03",
    "task": "T3",
    "title": "From the base document",
    "stage": "Open beta",
    "persona": "content editor",
    "components": [
      "C1",
      "C3",
      "C4",
      "C7"
    ],
    "steps": [
      {
        "title": "Open a base document",
        "component": "C3",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/structure",
        "expect": "The document list shows the base document with its version mark.",
        "story": "explorations-variants-2-0-components-c3-version-mark--default"
      },
      {
        "title": "Open the perspective control",
        "component": "C1",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/structure",
        "expect": "The version pill opens its menu. An extra row adds a dimension.",
        "story": "explorations-variants-2-0-c1-perspective-selector-option-a--open-beta"
      },
      {
        "title": "Pick a dimension and a definition",
        "component": "C1",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/structure",
        "expect": "The perspective row appears. The studio shows the chosen variant, or the base if none exists.",
        "story": "explorations-variants-2-0-c1-perspective-selector-option-a--open-beta"
      },
      {
        "title": "See the missing-variant banner",
        "component": "C7",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/structure",
        "expect": "A banner says this document has no version for the shown variant and offers Create.",
        "story": "explorations-variants-2-0-c7-banners-option-a--drafts-no-variant"
      },
      {
        "title": "Create the variant document",
        "component": "C7",
        "option": "A",
        "preset": "open-beta-a",
        "route": "/structure",
        "expect": "The variant is created from the base as a draft. The banner disappears.",
        "story": "explorations-variants-2-0-c7-banners-option-a--creating"
      }
    ]
  },
  {
