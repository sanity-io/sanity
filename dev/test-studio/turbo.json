{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "ENABLE_VITE_DEVTOOLS",
        "REACT_PRODUCTION_PROFILING",
        "SANITY_RUST_STUDIO",
        "SANITY_STUDIO_STYLE_OUTLINE",
        "VERCEL"
      ],
      // The build also compiles the Rust studio into `dist/rust` (`rust-studio:build`)
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dev/rust-studio/**",
        "!$TURBO_ROOT$/dev/rust-studio/dist/**",
        "!$TURBO_ROOT$/dev/rust-studio/target/**"
      ],
      "outputs": [".sanity/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
