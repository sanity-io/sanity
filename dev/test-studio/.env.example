# To disable strict mode on your local checkout:
# `cp .env.example .env.development`
# Then restart your `sanity dev` or `pnpm dev` command
SANITY_STUDIO_REACT_STRICT_MODE=false

# Opt-in style outline debug panel. Enabled on the Vercel test-studio project.
# SANITY_STUDIO_STYLE_OUTLINE=true

# OAuth 2.1 workspace at /oauth (staging project exx11uqh). Set to the client id of an OAuth
# application registered in Manage with http://localhost:3333/oauth as a redirect URL.
# SANITY_STUDIO_OAUTH_CLIENT_ID=oc-…
