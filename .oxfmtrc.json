{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "quoteProps": "consistent",
  "sortImports": {
    "groups": [
      ["side_effect", "side_effect_style"],
      ["builtin", "subpath"],
      ["external"],
      ["internal"],
      "unknown",
      ["parent", "sibling", "index", "style"]
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": [
    "pnpm-workspace.yaml",
    "**/CHANGELOG.md",
    "**/turbo.json",
    "**/generated/**/*.module.css.d.ts",
    ".agents/skills/animate/**",
    ".agents/skills/animation-performance/**",
    ".agents/skills/animation-vocabulary/**",
    ".agents/skills/apple-design/**",
    ".agents/skills/ask-emil/**",
    ".agents/skills/ask-sonner/**",
    ".agents/skills/break-ui/**",
    ".agents/skills/choreograph/**",
    ".agents/skills/emil-design-eng/**",
    ".agents/skills/find-animation-opportunities/**",
    ".agents/skills/gestures/**",
    ".agents/skills/improve-animations/**",
    ".agents/skills/learn-taste/**",
    ".agents/skills/mobile-native/**",
    ".agents/skills/modern-web-guidance/**",
    ".agents/skills/pick-ui-library/**",
    ".agents/skills/prototype/**",
    ".agents/skills/remove-animations/**",
    ".agents/skills/review-animations/**"
  ]
}
