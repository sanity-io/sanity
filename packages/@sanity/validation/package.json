{
  "name": "@sanity/validation",
  "version": "6.12.0",
  "description": "Document validation for Sanity schemas",
  "keywords": [
    "cms",
    "content",
    "headless",
    "sanity",
    "validation"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sanity.git",
    "directory": "packages/@sanity/validation"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "_internal": [
        "./lib/_internal.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "monorepo": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./_internal": {
      "monorepo": "./src/_internal.ts",
      "default": "./lib/_internal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.js",
      "./_internal": "./lib/_internal.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@sanity/client": "catalog:",
    "@sanity/id-utils": "^1.0.0",
    "@sanity/schema": "workspace:*",
    "@sanity/types": "workspace:*",
    "@sanity/util": "workspace:*",
    "dequal": "catalog:",
    "i18next": "^26.4.1",
    "lodash-es": "^4.18.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@repo/test-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/tsdown.config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    "node >=22.12",
    "baseline 2024"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
