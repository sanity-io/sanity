{
  "name": "@sanity/vision",
  "version": "6.11.0",
  "description": "Sanity plugin for running/debugging GROQ-queries against Sanity datasets",
  "keywords": [
    "admin",
    "cms",
    "content",
    "gui",
    "headless",
    "realtime",
    "sanity",
    "sanity-plugin",
    "vision"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sanity.git",
    "directory": "packages/@sanity/vision"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": true,
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "monorepo": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./bundle.css": {
      "types": "./lib/bundle-css.d.ts",
      "browser": "./lib/bundle.css",
      "style": "./lib/bundle.css",
      "node": "./lib/bundle-css.js",
      "default": "./lib/bundle-css.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.js",
      "./bundle.css": {
        "types": "./lib/bundle-css.d.ts",
        "browser": "./lib/bundle.css",
        "style": "./lib/bundle.css",
        "node": "./lib/bundle-css.js",
        "default": "./lib/bundle-css.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:bundle": "vite build --configLoader runner --config package.bundle.ts",
    "prepublishOnly": "turbo run build",
    "test": "vitest",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@rexxars/react-json-inspector": "^9.0.1",
    "@rexxars/react-split-pane": "^1.0.0",
    "@sanity/client": "catalog:",
    "@sanity/color": "^3.0.8",
    "@sanity/icons": "^5.2.1",
    "@sanity/lezer-groq": "^1.0.4",
    "@sanity/ui": "catalog:",
    "@sanity/uuid": "^3.0.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@vanilla-extract/dynamic": "catalog:",
    "is-hotkey-esm": "^1.0.0",
    "json-2-csv": "^5.5.9",
    "json5": "^2.2.3",
    "lodash-es": "^4.18.1",
    "quick-lru": "^7.3.0",
    "react-rx": "catalog:",
    "rxjs": "^7.8.2",
    "ui5": "catalog:",
    "use-effect-event": "^2.0.4"
  },
  "devDependencies": {
    "@repo/package.bundle": "workspace:*",
    "@repo/test-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/tsdown.config": "workspace:*",
    "@sanity/vanilla-extract-vite-plugin": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "oxc-transform-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "workspace:*",
    "styled-components": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "sanity": "^6.0.0-0"
  },
  "browserslist": [
    "node >=22.12",
    "baseline 2024"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
