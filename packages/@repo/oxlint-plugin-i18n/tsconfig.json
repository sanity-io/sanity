{
  "extends": "@repo/tsconfig/base.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": ["dist", "lib", "node_modules"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "module": "Preserve",
    "skipLibCheck": true,
    // The copy review CLI runs on Node's native TypeScript support, which needs `.ts` specifiers
    "allowImportingTsExtensions": true
  }
}
