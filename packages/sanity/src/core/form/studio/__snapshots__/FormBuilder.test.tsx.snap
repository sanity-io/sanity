// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FormBuilder > should render a studio form (with tree editing dialog) 1`] = `"<div data-testid="field-title"><div data-ui="FormRow"><div><div data-testid="form-field-gutter" style="--formFieldAnchorPath__kzylaa0: --input_title;"></div></div><div><div data-ui="VStack" data-level="0"><div data-ui="Flex"><div style="--flex-basis: 0%; --flex-grow: 1;" data-ui="fieldHeaderContentBox"><div data-ui="VStack"><div data-ui="Flex"><div data-ui="Flex"><label data-ui="Text" for="title"><span>Title</span></label></div></div></div></div></div><div data-ui="Box"><div><div data-testid="change-bar-wrapper"><div data-testid="change-bar__field-wrapper"><span data-as="span" data-ui="TextInput" data-scheme="light" data-tone="default"><span><input data-as="input" data-scheme="light" data-tone="default" data-ui="TextInput__input" id="title" autocomplete="off" style="anchor-name: --input_title;" type="text" value=""><span data-border="" data-scheme="light" data-tone="default" data-ui="TextInput__presentation"></span></span></span></div></div></div></div></div></div></div></div>"`;

exports[`FormBuilder > should render a studio form (without tree editing dialog) 1`] = `"<div data-testid="field-title"><div data-ui="FormRow"><div><div data-testid="form-field-gutter" style="--formFieldAnchorPath__kzylaa0: --input_title;"></div></div><div><div data-ui="VStack" data-level="0"><div data-ui="Flex"><div style="--flex-basis: 0%; --flex-grow: 1;" data-ui="fieldHeaderContentBox"><div data-ui="VStack"><div data-ui="Flex"><div data-ui="Flex"><label data-ui="Text" for="title"><span>Title</span></label></div></div></div></div></div><div data-ui="Box"><div><div data-testid="change-bar-wrapper"><div data-testid="change-bar__field-wrapper"><span data-as="span" data-ui="TextInput" data-scheme="light" data-tone="default"><span><input data-as="input" data-scheme="light" data-tone="default" data-ui="TextInput__input" id="title" autocomplete="off" style="anchor-name: --input_title;" type="text" value=""><span data-border="" data-scheme="light" data-tone="default" data-ui="TextInput__presentation"></span></span></span></div></div></div></div></div></div></div></div>"`;
