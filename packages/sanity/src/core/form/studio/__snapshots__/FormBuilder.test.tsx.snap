exports[`FormBuilder > should render a studio form (with tree editing dialog) 1`] = `"<div data-testid="field-title"><div data-ui="FormRow"><div><div style="--formFieldAnchorPath__kzylaa0: --input_title;"></div></div><div><div data-as="div" data-ui="Stack" data-level="0"><div style="--min-height: 0; --min-width: 0;" data-ui="Flex"><div style="--min-height: 0; --min-width: 0; --flex-basis: 0%; --flex-grow: 1;" data-ui="fieldHeaderContentBox"><div data-as="div" data-ui="Stack"><div style="--min-height: 0; --min-width: 0;" data-ui="Flex"><div style="--min-height: 0; --min-width: 0;" data-ui="Flex"><label data-ui="Text" for="title"><span>Title</span></label></div></div></div></div></div><div><div><div data-testid="change-bar-wrapper"><div data-testid="change-bar__field-wrapper"><span data-as="span" data-ui="TextInput" data-scheme="light" data-tone="default"><span><input data-as="input" data-scheme="light" data-tone="default" id="title" autocomplete="off" style="anchor-name: --input_title;" type="text" value=""><span data-border="" data-scheme="light" data-tone="default"></span></span></span></div></div></div></div></div></div></div></div>"`;

